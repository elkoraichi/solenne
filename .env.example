# La Maison de Solenne — variables d'environnement
# Copier ce fichier en `.env` et renseigner chaque valeur.
# L'application REFUSE de démarrer si une variable obligatoire manque (SETUP-004).

# --- Base de données (obligatoire) ---
DATABASE_URL="postgresql://user:password@localhost:5432/solenne_dev"

# Base utilisée par les tests d'intégration. Elle est effacée à chaque exécution.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/solenne_test"

# --- Authentification (obligatoire) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET="remplacer-par-un-secret-de-32-octets-minimum"

# --- Adresse publique de l'application (obligatoire) ---
# D6 : le domaine n'est pas arrêté. Il n'est JAMAIS écrit en dur dans le code.
APP_URL="http://localhost:3000"

# --- Envoi d'emails ---
# Obligatoire en production uniquement. En développement, les emails sont écrits
# dans les journaux au lieu d'être envoyés.
RESEND_API_KEY=""
EMAIL_FROM="La Maison de Solenne <bonjour@example.test>"
